# Copy this file to ".env" in the same folder (backend/.env) and fill in
# real values. Never commit the real ".env" file to git.

# --- Local development (safe defaults) ---
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-secret-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_USE_HTTPS=false

# --- Production example (uncomment / edit and set these instead) ---
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=<generate a long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`>
# DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# DJANGO_CORS_ALLOWED_ORIGINS=https://yourdomain.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# DJANGO_USE_HTTPS=true   # only after HTTPS/TLS is actually configured on the server

# Used only by "python manage.py seed_data" (local/demo data, optional)
# SEED_ADMIN_PASSWORD=choose-a-password-for-the-demo-admin-account
# DJANGO_CROSS_DOMAIN_COOKIES=true